{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"],
    "typeRoots": ["../backend/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "typeorm": ["../backend/node_modules/typeorm"],
      "reflect-metadata": ["../backend/node_modules/reflect-metadata"]
    }
  },
  "include": ["**/*.ts"],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
